    def setup_database(self):
        """יצירת מסד נתונים וטבלאות"""
        try:
            # התחברות ללא מסד נתונים ספציפי
            conn = mysql.connector.connect(
                host=self.db_config['host'],
                user=self.db_config['user'],
                password=self.db_config['password']
            )
            cursor = conn.cursor()
            
            # יצירת מסד נתונים
            cursor.execute("CREATE DATABASE IF NOT EXISTS stock_recommendations")
            cursor.close()
            conn.close()
            
            # התחברות למסד הנתונים החדש
            conn = mysql.connector.connect(**self.db_config)
            cursor = conn.cursor()
            
            # יצירת טבלת פורטפוליו לטווח ארוך
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS long_term_portfolio (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    date_created DATETIME,
                    investment_amount DECIMAL(10,2),
                    symbol VARCHAR(10),
                    fund_name VARCHAR(100),
                    current_price DECIMAL(10,2),
                    recommended_shares INT,
                    total_cost DECIMAL(10,2)
                )
            """)
            
            # יצירת טבלת סיגנלי מסחר לטווח בינוני
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS trading_signals (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    date_created DATETIME,
                    symbol VARCHAR(10),
                    current_price DECIMAL(10,2),
                    support_level DECIMAL(10,2),
                    resistance_level DECIMAL(10,2),
                    signal_type VARCHAR(20),
                    entry_point DECIMAL(10,2),
                    exit_point DECIMAL(10,2),
                    risk_reward_ratio DECIMAL(5,2)
                )
            """)
            
            cursor.close()
            conn.close()
            print("✅ מסד הנתונים הוקם בהצלחה")
            
        except mysql.connector.Error as e:
            print(f"❌ שגיאה ביצירת מסד הנתונים: {e}")
    
    def get_long_term_recommendations(self, investment_amount):
        """קבלת המלצות השקעה לטווח ארוך"""
        print(f"\n📊 מחפש המלצות השקעה לטווח ארוך לסכום: ${investment_amount:,.2f}")
        
        # סמלי קרנות SP500 ו-NASDAQ
        etf_symbols = {
            'SPY': 'SPDR S&P 500 ETF Trust',
            'VOO': 'Vanguard S&P 500 ETF',
            'QQQ': 'Invesco QQQ Trust (NASDAQ-100)',
            'VTI': 'Vanguard Total Stock Market ETF'
        }
        
        recommendations = []
        
        for symbol, name in etf_symbols.items():
            try:
                # קבלת נתונים
                ticker = yf.Ticker(symbol)
                info = ticker.info
                current_price = info.get('regularMarketPrice', info.get('previousClose', 0))
                
                if current_price == 0:
                    continue
                
                # חישוב מספר יחידות מומלץ (25% מהתיק לכל קרן)
                allocation = investment_amount * 0.25
                recommended_shares = int(allocation // current_price)
                total_cost = recommended_shares * current_price
                
                recommendations.append({
                    'symbol': symbol,
                    'name': name,
                    'current_price': current_price,
                    'recommended_shares': recommended_shares,
                    'total_cost': total_cost
                })
                
                # שמירה במסד הנתונים
                self.save_long_term_recommendation(
                    investment_amount, symbol, name, current_price, 
                    recommended_shares, total_cost
                )
                
            except Exception as e:
                print(f"⚠️ שגיאה בקבלת נתונים עבור {symbol}: {e}")
        
        return recommendations
    
    def calculate_support_resistance(self, df, period=20):
        """חישוב רמות תמיכה והתנגדות"""
        # חישוב מינימום ומקסימום מתגלגל
        df['rolling_min'] = df['Low'].rolling(window=period).min()
        df['rolling_max'] = df['High'].rolling(window=period).max()
        
        # רמת תמיכה - ממוצע של המינימומים האחרונים
        support = df['rolling_min'].iloc[-5:].mean()
        
        # רמת התנגדות - ממוצע של המקסימומים האחרונים
        resistance = df['rolling_max'].iloc[-5:].mean()
        
        return support, resistance
    
    def generate_trading_signal(self, symbol, current_price, support, resistance):
        """יצירת סיגנל מסחר"""
        # חישוב יחס סיכון-תשואה
        if resistance > current_price > support:
            distance_to_support = current_price - support
            distance_to_resistance = resistance - current_price
            
            if distance_to_support < distance_to_resistance * 0.3:
                # קרוב לתמיכה - סיגנל קנייה
                signal = "BUY"
                entry_point = current_price
                exit_point = resistance * 0.95  # יציאה קצת לפני ההתנגדות
                risk_reward = distance_to_resistance / distance_to_support
            elif distance_to_resistance < distance_to_support * 0.3:
                # קרוב להתנגדות - סיגנל מכירה
                signal = "SELL"
                entry_point = current_price
                exit_point = support * 1.05  # יציאה קצת אחרי התמיכה
                risk_reward = distance_to_support / distance_to_resistance
            else:
                # באמצע - המתנה
                signal = "HOLD"
                entry_point = current_price
                exit_point = current_price
                risk_reward = 1.0
        else:
            signal = "HOLD"
            entry_point = current_price
            exit_point = current_price
            risk_reward = 1.0
        
        return signal, entry_point, exit_point, risk_reward
    
    def get_medium_term_recommendations(self):
        """קבלת המלצות מסחר לטווח בינוני"""
        print("\n📈 מחפש הזדמנויות מסחר לטווח בינוני...")
        
        # מניות לדוגמה מה-SP500
        stocks = ['NFLX', 'AAPL']  # נטפליקס ואפל לדוגמה
        
        recommendations = []
        
        for symbol in stocks:
            try:
                # קבלת נתונים היסטוריים
                ticker = yf.Ticker(symbol)
                df = ticker.history(period='3mo')  # 3 חודשים אחרונים
                
                if df.empty:
                    continue
                
                current_price = df['Close'].iloc[-1]
                
                # חישוב תמיכה והתנגדות
                support, resistance = self.calculate_support_resistance(df)
                
                # יצירת סיגנל מסחר
                signal, entry_point, exit_point, risk_reward = self.generate_trading_signal(
                    symbol, current_price, support, resistance
                )
                
                recommendations.append({
                    'symbol': symbol,
                    'current_price': current_price,
                    'support_level': support,
                    'resistance_level': resistance,
                    'signal_type': signal,
                    'entry_point': entry_point,
                    'exit_point': exit_point,
                    'risk_reward_ratio': risk_reward
                })
                
                # שמירה במסד הנתונים
                self.save_trading_signal(
                    symbol, current_price, support, resistance,
                    signal, entry_point, exit_point, risk_reward
                )
                
            except Exception as e:
                print(f"⚠️ שגיאה בקבלת נתונים עבור {symbol}: {e}")
        
        return recommendations
    
    def save_long_term_recommendation(self, investment_amount, symbol, fund_name, 
                                    current_price, recommended_shares, total_cost):
        """שמירת המלצה לטווח ארוך במסד הנתונים"""
        try:
            conn = mysql.connector.connect(**self.db_config)
            cursor = conn.cursor()
            
            query = """
                INSERT INTO long_term_portfolio 
                (date_created, investment_amount, symbol, fund_name, current_price, 
                 recommended_shares, total_cost)
                VALUES (%s, %s, %s, %s, %s, %s, %s)
            """
            
            values = (
                datetime.now(), investment_amount, symbol, fund_name,
                current_price, recommended_shares, total_cost
            )
            
            cursor.execute(query, values)
            conn.commit()
            cursor.close()
            conn.close()
            
        except mysql.connector.Error as e:
            print(f"⚠️ שגיאה בשמירת נתונים לטווח ארוך: {e}")
    
    def save_trading_signal(self, symbol, current_price, support, resistance,
                           signal, entry_point, exit_point, risk_reward):
        """שמירת סיגנל מסחר במסד הנתונים"""
        try:
            conn = mysql.connector.connect(**self.db_config)
            cursor = conn.cursor()
            
            query = """
                INSERT INTO trading_signals 
                (date_created, symbol, current_price, support_level, resistance_level,
                 signal_type, entry_point, exit_point, risk_reward_ratio)
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
            """
            
            values = (
                datetime.now(), symbol, current_price, support, resistance,
                signal, entry_point, exit_point, risk_reward
            )
            
            cursor.execute(query, values)
            conn.commit()
            cursor.close()
            conn.close()
            
        except mysql.connector.Error as e:
            print(f"⚠️ שגיאה בשמירת סיגנל מסחר: {e}")
    
