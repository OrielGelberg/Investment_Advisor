    def get_portfolio_history_api(self, days=30):
        """API method - קבלת היסטוריית פורטפוליו"""
        try:
            conn = mysql.connector.connect(**self.db_config)
            cursor = conn.cursor(dictionary=True)
            
            # שליפת נתוני פורטפוליו
            cursor.execute("""
                SELECT * FROM long_term_portfolio 
                WHERE date_created >= DATE_SUB(NOW(), INTERVAL %s DAY)
                ORDER BY date_created DESC
            """, (days,))
            
            portfolio_history = cursor.fetchall()
            
            # שליפת סיגנלי מסחר
            cursor.execute("""
                SELECT * FROM trading_signals 
                WHERE date_created >= DATE_SUB(NOW(), INTERVAL %s DAY)
                ORDER BY date_created DESC
            """, (days,))
            
            trading_history = cursor.fetchall()
            
            cursor.close()
            conn.close()
            
            # המרה לפורמט JSON
            for record in portfolio_history + trading_history:
                if 'date_created' in record:
                    record['date_created'] = record['date_created'].isoformat()
            
            return {
                'success': True,
                'data': {
                    'portfolioHistory': portfolio_history,
                    'tradingHistory': trading_history,
                    'periodDays': days
                }
            }
            
        except mysql.connector.Error as e:
            return {
                'success': False,
                'error': f'Database error: {str(e)}'
            }
    
